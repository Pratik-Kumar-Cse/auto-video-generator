# Application Configuration
APP_NAME=Video Generator API
DEBUG=true
ENV=dev

# Logging Configuration
LOG_LEVEL=INFO
LOG_LEVEL_SERVICES=INFO
LOG_LEVEL_API=INFO
LOG_LEVEL_AGENTS=DEBUG
LOG_LEVEL_TASKS=INFO
LOG_LEVEL_CORE=WARNING
LOG_LEVEL_MODELS=WARNING
LOG_LEVEL_UTILS=WARNING
LOG_LEVEL_MIDDLEWARE=WARNING

# Server Configuration
HOST=0.0.0.0
PORT=8000
ORIGIN=http://localhost:3000

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
MONGO_URI=mongodb://localhost:27017/video_generator
MONGO_DB_NAME=video_generator

# Cache Configuration
CACHE_PROVIDER=redis

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# RABBITMQ_BROKER_URL=redis://localhost:6379/1
CELERY_BACKEND_URL=redis://localhost:6379/2

# Rate Limiting
RATE_LIMIT=60

# Frontend Configuration
FRONTEND_ENDPOINT=http://localhost:3000
USER_JWT_COOKIE=user_jwt
DOMAIN=localhost

# Token Configuration
TOKEN_EXPIRY_IN_HOUR=24
LOGIN_EXPIRE_TIME=30
REFRESH_EXPIRE_TIME=7

# URLs
LOGIN_URL=http://localhost:3000/login
API_GATEWAY_URL=http://localhost:8000

# ImageMagick Binary Path (Download from https://imagemagick.org/script/download.php)
IMAGEMAGICK_BINARY=/opt/homebrew/bin/convert

# External API Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
REQUESTY_KEY=your-requesty-api-key-here
CLAUDE_KEY=sk-ant-your-claude-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEEPSEEK_API=your-deepseek-api-key-here

# Email Configuration
EMAIL_ID=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_SUBSTRING=@example.com

# Google Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CONSOLE_API_KEY=your-google-console-api-key
REDIRECT_URI=http://localhost:8000/auth/google/callback
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# Stock Media APIs
STORYBLOCKS_API_KEY=your-storyblocks-api-key
STORYBLOCKS_SCRECT_KEY=your-storyblocks-secret-key
PEXELS_API_KEY=your-pexels-api-key
ASSEMBLY_AI_API_KEY=your-assembly-ai-api-key

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=your-s3-bucket
AWS_REGION=us-east-1
AWS_BASE_URL=https://s3.amazonaws.com

# Search APIs
SERPER_API_KEY=your-serper-api-key
TAVILY_API_KEY=tvly-your-tavily-api-key

# Video Generation APIs
HEYGEN_API_KEY=your-heygen-api-key
LEONARDO_API_KEY=your-leonardo-api-key
REPLICATE_API_TOKEN=r8_your-replicate-token
GETTY_IMAGES_API_KEY=your-getty-images-api-key
FREEPIK_API_KEY=your-freepik-api-key

# Webhook Configuration
WEBHOOK_ENDPOINT=http://localhost:8000/webhook

# Social Media APIs
META_CLIENT_ID=your-meta-client-id
META_CLIENT_SECRET=your-meta-client-secret
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback

# Proxy Configuration
WEBSHARE_PROXY_API=your-webshare-proxy-api

# Stock APIs
SUTTERSTOCK_TOKEN=your-shutterstock-token

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
MIXPANEL_TOKEN=your-mixpanel-token
MIXPANEL_SECRET=your-mixpanel-secret

# Waitlist Configuration
WAITLIST_ENABLED=false

# Queue Configuration
QUEUE_NAME=video_generation

# Workflow Configuration
WORKFLOW_API_ENDPOINT=http://localhost:8000/api/v1/workflow
WORKFLOW_SECRET_KEY=your-workflow-secret-key

# File Upload Configuration
MAX_UPLOAD_SIZE=100MB

# Development Configuration
TESTING=false